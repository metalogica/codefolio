---
import '../../styles/global.css';
import { AstroSeo } from '@astrolib/seo';

const DEFAULT_TITLE = 'Rei Jarram — Founder, Metalogica';
const DEFAULT_DESCRIPTION =
  'Founder of Metalogica — building Ideosphere and Dreamtable. Full stack engineer based in Montreal, QC.';
---

<meta charset='UTF-8' />
<meta http-equiv='X-UA-Compatible' content='IE=edge' />
<meta
  name='viewport'
  content='width=device-width, initial-scale=1, maximum-scale=1'
/>
<meta name='author' content='rei jarram' />

<AstroSeo
  title={Astro.props.title || DEFAULT_TITLE}
  description={Astro.props.description || DEFAULT_DESCRIPTION}
  canonical={Astro.props.canonical || 'https://rei.gg'}
  openGraph={{
    url: Astro.props.openGraph?.url || 'https://rei.gg',
    title: Astro.props.openGraph?.title || DEFAULT_TITLE,
    description: Astro.props.openGraph?.description || DEFAULT_DESCRIPTION,
    images: [
      {
        url: 'https://rei.gg/og.png',
        width: 1200,
        height: 630,
        alt: 'rei.gg — a PC-98 style desktop',
      },
    ],
    site_name: Astro.props.openGraph?.site_name || 'rei.gg',
  }}
/>

<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='alternate icon' href='/favicon.ico' sizes='any' />
<link rel='apple-touch-icon' href='/favicon.svg' />

<meta name='msapplication-TileColor' content='#0a0a14' />
<meta name='theme-color' content='#0a0a14' />

<link rel='sitemap' href='/sitemap-index.xml' />

<link
  rel='preload'
  href='/fonts/dotgothic16-latin.woff2'
  as='font'
  type='font/woff2'
  crossorigin
/>
<link
  rel='preload'
  href='/fonts/web437-ibm-vga-8x16.woff'
  as='font'
  type='font/woff'
  crossorigin
/>
